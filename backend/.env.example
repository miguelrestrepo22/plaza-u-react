# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube a GitHub.

PORT=3000

# Llave con la que se firman los tokens. Pon una frase larga y secreta.
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta
JWT_EXPIRES_IN=8h

# --- Base de datos ---
# Sin DATABASE_URL la API usa un PostgreSQL embebido (PGlite) guardado en .data/ y funciona sin instalar nada.
# Con DATABASE_URL se conecta a PostgreSQL de verdad, por ejemplo la base de Supabase:
#   Supabase > Project Settings > Database > Connection string > "Session pooler" (puerto 5432)
# DATABASE_URL=postgresql://postgres.xxxx:TU-CONTRASEÑA@aws-0-region.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# Las tablas de la API se crean en este esquema para no mezclarse con las del sitio publicado:
# DATABASE_SCHEMA=plaza_express
